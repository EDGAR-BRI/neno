---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "IT'S MY BIRTHDAY | Sábado 03 de Octubre", 
  description = "Acompáñame a cantar mi cumpleaños. Sábado 03 de Octubre a las 5:30PM en Mi casa." 
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#101217" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / WhatsApp sharing preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/background.jpg" />

    <title>{title}</title>
  </head>
  <body>
    <div class="app-viewport">
      <main class="mobile-wrapper">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
